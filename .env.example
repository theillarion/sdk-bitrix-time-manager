# Paste the BASE webhook URL here locally, without a method name.
BITRIX_WEBHOOK_URL=https://your-portal.example/rest/500/REPLACE_LOCALLY/
BITRIX_TIMEZONE=Europe/Moscow
BITRIX_STATE_PATH=.state/operations.sqlite3
BITRIX_TIMEOUT=20
BITRIX_READ_RETRIES=2
# Python API writes also require dry_run=False. CLI writes require --apply.
BITRIX_ALLOW_WRITES=false
